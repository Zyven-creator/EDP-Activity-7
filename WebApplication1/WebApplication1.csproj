<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);StudentInfoSystemAPI\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.6.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="StudentInfoSystemAPI\**\*.cs" />
    <Compile Remove="AboutForm.cs" />
    <Compile Remove="DashboardForm.cs" />
    <Compile Remove="DatabaseHelper.cs" />
    <Compile Remove="LoginForm.cs" />
    <Compile Remove="PasswordRecoveryForm.cs" />
    <Compile Remove="ReportGeneratorForm.cs" />
    <Content Remove="StudentInfoSystemAPI\**" />
    <EmbeddedResource Remove="StudentInfoSystemAPI\**" />
    <None Remove="StudentInfoSystemAPI\**" />
  </ItemGroup>

</Project>
